// Generated by infra/main.tf. Do not edit in the console.
// Runs on every viewer request (CloudFront Functions, cloudfront-js-2.0).
var REDIRECTS = ${redirects};
var REWRITE_TO_INDEX = ${rewrite_to_index};

function handler(event) {
  var request = event.request;
  var uri = request.uri;

  var key = uri.length > 1 && uri.endsWith('/') ? uri.slice(0, -1) : uri;
  var target = REDIRECTS[key];
  if (target) {
    return {
      statusCode: 301,
      statusDescription: 'Moved Permanently',
      headers: { location: { value: target } },
    };
  }

  // Pre-rendered Nuxt writes /about/index.html. A private S3 origin has no
  // directory indexes, so map /about and /about/ onto that file.
  if (REWRITE_TO_INDEX) {
    if (uri.endsWith('/')) {
      request.uri = uri + 'index.html';
    } else if (uri.lastIndexOf('.') < uri.lastIndexOf('/')) {
      request.uri = uri + '/index.html';
    }
  }

  return request;
}
